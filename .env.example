PORT=5175
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# Auth — registration requires this shared invite code
INVITE_CODE=devinvite
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE_MS=2592000000
BCRYPT_SALT_ROUNDS=10

# Game. In development, use the fast dev values below (~1 minute per run):
# challenge every 6 s, 5 responses, 30 s to answer each. Production keeps the
# real hour-long values (6 min interval, 10 responses, 90 s lateness).
#   dev:  GAME_REQUIRED_RESPONSES=5, GAME_CHALLENGE_INTERVAL_MS=6000,
#         GAME_LATENESS_MS=30000, GAME_MIN_REACTION_MS=250
#   prod: GAME_REQUIRED_RESPONSES=10, GAME_CHALLENGE_INTERVAL_MS=360000,
#         GAME_LATENESS_MS=90000, GAME_MIN_REACTION_MS=400
GAME_SERVER_SECRET=dev-game-secret
GAME_REQUIRED_RESPONSES=5
GAME_CHALLENGE_INTERVAL_MS=6000
GAME_LATENESS_MS=30000
GAME_TOLERANCE=0.03
GAME_MIN_REACTION_MS=250
GAME_NONCE_TTL_MS=120000

# MongoDB (Atlas) — per-user Spotify token storage (used in production/staging;
# development runs an in-memory MongoDB automatically)
DB_NAME=DupontdokuDB
DB_USER=
DB_PASSWORD=
DB_HOST=main.qygovot.mongodb.net

# Encryption key for tokens at rest (32+ random chars)
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Spotify app from https://developer.spotify.com/dashboard (Client Credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Artist shown in the music player (fallback if no ID is set)
SPOTIFY_ARTIST_NAME=Dupont
# Spotify artist resolved by ID — preferred; take it from the artist URL on open.spotify.com
SPOTIFY_ARTIST_ID=0hFtMoaSeAgCISzAlrWYxh

# OAuth playback: full-track playback in the browser via Web Playback SDK.
# Requires the connecting account to have Spotify Premium. The redirect URI
# must be registered in the Spotify dashboard. In dev with ngrok, this is
# overridden automatically.
SPOTIFY_PLAYBACK_REDIRECT_URI=http://localhost:5175/api/spotify-auth/callback

# ngrok (dev only — optional; enables Spotify OAuth callback via public tunnel)
# Architecture: a persistent Cloud Endpoint (created in the ngrok dashboard) sits
# at NGROK_DOMAIN with a Traffic Policy that uses forward-internal to route to an
# agent (NGROK_INTERNAL_DOMAIN), so the public domain is never claimed directly —
# no "already online" conflicts on restart.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-cloud-endpoint-domain.ngrok-free.dev
NGROK_INTERNAL_DOMAIN=default.internal

# Spotify artist resolved by ID (from the artist URL on open.spotify.com)
